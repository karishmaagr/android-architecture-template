digraph CleanArchitecture {
    rankdir=TB
    bgcolor=white
    pad=0.5
    nodesep=0.6
    ranksep=0.7

    node [fontname="Helvetica Neue,Helvetica,Arial", fontsize=11, penwidth=0, margin="0.2,0.12", style="filled,rounded"]
    edge [fontname="Helvetica Neue,Helvetica,Arial", fontsize=10, penwidth=1.0, color="#888888"]

    // ── Presentation layer ────────────────────────────────
    subgraph cluster_ui {
        label="Presentation Layer  ·  feature:X:ui"
        fontname="Helvetica Neue,Helvetica,Arial"
        fontsize=12
        fontcolor="#8e44ad"
        style="filled,rounded"
        fillcolor="#f5eef8"
        color="#8e44ad"
        penwidth=1.5
        margin=16

        SCREEN  [label="Composable Screen", fillcolor="#8e44ad", fontcolor=white]
        VM      [label="ViewModel", fillcolor="#8e44ad", fontcolor=white]
        MVI     [label="State · Intent · Effect", fillcolor="#d2b4de", fontcolor="#4a235a"]
    }

    // ── Domain layer ──────────────────────────────────────
    subgraph cluster_domain {
        label="Domain Layer  ·  feature:X:domain  ·  pure Kotlin"
        fontname="Helvetica Neue,Helvetica,Arial"
        fontsize=12
        fontcolor="#27ae60"
        style="filled,rounded"
        fillcolor="#eafaf1"
        color="#27ae60"
        penwidth=1.5
        margin=16

        USECASE  [label="UseCase", fillcolor="#27ae60", fontcolor=white]
        REPO_IF  [label="Repository Interface", fillcolor="#27ae60", fontcolor=white]
        MODEL    [label="Domain Model", fillcolor="#a9dfbf", fontcolor="#1e8449"]
    }

    // ── Data layer ────────────────────────────────────────
    subgraph cluster_data {
        label="Data Layer  ·  feature:X:data"
        fontname="Helvetica Neue,Helvetica,Arial"
        fontsize=12
        fontcolor="#e67e22"
        style="filled,rounded"
        fillcolor="#fef9e7"
        color="#e67e22"
        penwidth=1.5
        margin=16

        REPO_IMPL [label="RepositoryImpl", fillcolor="#e67e22", fontcolor=white]
        REMOTE    [label="Remote DataSource", fillcolor="#e67e22", fontcolor=white]
        LOCAL     [label="Local DataSource", fillcolor="#e67e22", fontcolor=white]
        DTO       [label="DTO · Entity", fillcolor="#f9e4b7", fontcolor="#784212"]
        MAPPER    [label="Mapper  toDomain()", fillcolor="#f9e4b7", fontcolor="#784212"]
    }

    // ── Core layer ────────────────────────────────────────
    subgraph cluster_core {
        label="Core Layer  ·  shared infrastructure"
        fontname="Helvetica Neue,Helvetica,Arial"
        fontsize=12
        fontcolor="#2980b9"
        style="filled,rounded"
        fillcolor="#eaf4fb"
        color="#2980b9"
        penwidth=1.5
        margin=16

        CORE [label="core:network  ·  core:database  ·  core:data\ncore:domain  ·  core:ui  ·  core:common",
              fillcolor="#2980b9", fontcolor=white, shape=box, margin="0.3,0.15"]
    }

    // ── Presentation internal ─────────────────────────────
    SCREEN -> VM  [label=" onIntent() ", dir=both, arrowhead=normal, arrowtail=normal]
    VM -> MVI

    // ── Presentation → Domain ─────────────────────────────
    VM -> USECASE  [label=" invokes "]
    USECASE -> MODEL [label=" returns "]
    MODEL -> SCREEN [label=" drives recompose ", style=dashed]

    // ── Domain internal ───────────────────────────────────
    USECASE -> REPO_IF [label=" calls "]

    // ── Dependency inversion ──────────────────────────────
    REPO_IMPL -> REPO_IF [label=" implements ", style=dashed, color="#e67e22", fontcolor="#e67e22"]

    // ── Data internal ─────────────────────────────────────
    REPO_IMPL -> REMOTE
    REPO_IMPL -> LOCAL
    REMOTE -> DTO
    LOCAL  -> DTO
    DTO -> MAPPER
    MAPPER -> MODEL [label=" toDomain() "]

    // ── Data → Core ───────────────────────────────────────
    REMOTE -> CORE [label=" Retrofit "]
    LOCAL  -> CORE [label=" Room / DataStore "]
}
